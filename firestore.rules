rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Base authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // User profile documents & private notifications
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /notifications/{notifId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Helper to verify management authority on a workspace by ID (Owner or Admin only)
    function canManageWorkspaceById(wsId) {
      let ws = get(/databases/$(database)/documents/workspaces/$(wsId)).data;
      return ws != null &&
             ws.type != 'personal' &&
             isAuthenticated() && (
               ws.ownerUid == request.auth.uid ||
               (ws.members != null && (request.auth.uid in ws.members) &&
                ws.memberRoles != null && ws.memberRoles[request.auth.uid] == 'admin')
             );
    }

    // Helper to verify that the invitation creator remains currently authorized in the workspace
    function isCurrentAuthorizedCreator(ws, creatorUid) {
      return creatorUid is string && (
        (ws.ownerUid == creatorUid) ||
        (ws.members != null && (creatorUid in ws.members) &&
         ws.get('memberRoles', null) != null &&
         ws.memberRoles[creatorUid] == 'admin')
      );
    }

    // Global Invitation Lookup by Token Hash (Family & Business only)
    match /invitations/{tokenHash} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId is string &&
        canManageWorkspaceById(request.resource.data.workspaceId) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.tokenHash == tokenHash &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role in ['editor', 'viewer'];

      function isValidBatchInviteAcceptance() {
        let wsId = resource.data.workspaceId;
        let wsAfter = getAfter(/databases/$(database)/documents/workspaces/$(wsId)).data;
        let memAfter = getAfter(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data;
        return wsAfter != null &&
               memAfter != null &&
               wsAfter.type != 'personal' &&
               isCurrentAuthorizedCreator(wsAfter, resource.data.createdByUid) &&
               (request.auth.uid in wsAfter.members) &&
               wsAfter.get('memberRoles', null) != null &&
               wsAfter.memberRoles[request.auth.uid] == resource.data.role &&
               wsAfter.get('lastInviteTokenHash', '') == tokenHash &&
               memAfter.uid == request.auth.uid &&
               memAfter.role == resource.data.role &&
               memAfter.inviteTokenHash == tokenHash;
      }

      allow update: if isAuthenticated() && (
        // 1. Legitimate Workspace Manager Revocation (status pending -> revoked only, all other fields immutable)
        (canManageWorkspaceById(resource.data.workspaceId) &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'revoked' &&
         request.resource.data.get('acceptedByUid', null) == null &&
         request.resource.data.workspaceId == resource.data.workspaceId &&
         request.resource.data.tokenHash == resource.data.tokenHash &&
         request.resource.data.createdByUid == resource.data.createdByUid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.get('invitedEmail', null) == resource.data.get('invitedEmail', null) &&
         request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
         request.resource.data.get('expiresAt', null) == resource.data.get('expiresAt', null)) ||
        // 2. Legitimate Invitee Acceptance as part of authorized workspace-join batch
        (resource.data.status == 'pending' &&
         request.resource.data.status == 'accepted' &&
         request.resource.data.acceptedByUid == request.auth.uid &&
         (resource.data.get('expiresAt', null) == null || request.time < resource.data.expiresAt) &&
         (resource.data.get('invitedEmail', null) == null || resource.data.invitedEmail == '' ||
          (request.auth.token.email != null && request.auth.token.email.lower() == resource.data.invitedEmail.lower())) &&
         request.resource.data.workspaceId == resource.data.workspaceId &&
         request.resource.data.tokenHash == resource.data.tokenHash &&
         request.resource.data.createdByUid == resource.data.createdByUid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.get('invitedEmail', null) == resource.data.get('invitedEmail', null) &&
         request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
         request.resource.data.get('expiresAt', null) == resource.data.get('expiresAt', null) &&
         isValidBatchInviteAcceptance())
      );

      // Invitations cannot be deleted to preserve tamper-resistant audit logs
      allow delete: if false;
    }

    // Multi-Workspace Architecture
    match /workspaces/{workspaceId} {
      function getWorkspace() {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
      }

      function isPersonal(ws) {
        return ws.type == 'personal';
      }

      function isOwner(ws) {
        return isAuthenticated() && ws.ownerUid == request.auth.uid;
      }

      function isMember(ws) {
        return isAuthenticated() && (
          ws.ownerUid == request.auth.uid ||
          (ws.members != null && (request.auth.uid in ws.members))
        );
      }

      function getUserRole(ws) {
        return isOwner(ws) ? 'owner' :
          (ws.memberRoles != null && ws.memberRoles[request.auth.uid] != null)
            ? ws.memberRoles[request.auth.uid]
            : 'viewer';
      }

      function canCreateEntries(ws) {
        return isOwner(ws) || (
          !isPersonal(ws) && isMember(ws) &&
          (getUserRole(ws) in ['owner', 'admin', 'editor'])
        );
      }

      function canEditEntry(ws, entryData) {
        return isOwner(ws) || (
          !isPersonal(ws) && isMember(ws) && (
            getUserRole(ws) == 'admin' ||
            (getUserRole(ws) == 'editor' && entryData.createdByUid == request.auth.uid)
          )
        );
      }

      function canDeleteEntry(ws, entryData) {
        return isOwner(ws) || (
          !isPersonal(ws) && isMember(ws) && (
            getUserRole(ws) == 'admin' ||
            (getUserRole(ws) == 'editor' && entryData.createdByUid == request.auth.uid)
          )
        );
      }

      function canManageWorkspace(ws) {
        return isOwner(ws) || (
          !isPersonal(ws) && isMember(ws) && getUserRole(ws) == 'admin'
        );
      }

      function isValidActivityAction(ws, data) {
        let action = data.action;
        return (
          // Administrative actions: Owner only
          (action in ['role_changed', 'member_removed', 'workspace_deleted'] && isOwner(ws)) ||
          // Management actions: Owner or Admin
          (action in ['invite_created', 'invite_revoked', 'request_approved', 'request_rejected', 'settings_changed'] && canManageWorkspace(ws)) ||
          // Content actions: Owner, Admin, or Editor
          (action in ['entry_created', 'entry_edited', 'entry_deleted'] && canCreateEntries(ws)) ||
          // Self-initiated member actions
          (action in ['member_joined', 'request_submitted', 'backup_created', 'restore_completed', 'restore_failed', 'import_completed'] && isMember(ws))
        );
      }

      function isValidInviteJoin(ws, reqData) {
        let tokenHash = reqData.lastInviteTokenHash;
        let invBefore = get(/databases/$(database)/documents/invitations/$(tokenHash)).data;
        let invAfter = getAfter(/databases/$(database)/documents/invitations/$(tokenHash)).data;
        return tokenHash is string &&
               invBefore != null &&
               invAfter != null &&
               invBefore.workspaceId == workspaceId &&
               isCurrentAuthorizedCreator(ws, invBefore.createdByUid) &&
               invBefore.status == 'pending' &&
               invAfter.status == 'accepted' &&
               invAfter.acceptedByUid == request.auth.uid &&
               (invBefore.expiresAt == null || request.time < invBefore.expiresAt) &&
               (invBefore.invitedEmail == null || invBefore.invitedEmail == '' ||
                (request.auth.token.email != null && request.auth.token.email.lower() == invBefore.invitedEmail.lower())) &&
               (invBefore.role in ['editor', 'viewer']) &&
               (reqData.memberRoles[request.auth.uid] == invBefore.role);
      }

      // Workspace document rules
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;

      // Personal is strictly owner-only; Family/Business allows active members
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        (!isPersonal(resource.data) && (request.auth.uid in resource.data.members))
      );

      // Only owner can transfer ownership; admins can update basic settings;
      // An authenticated user joining non-personal workspace via invite can append themselves to members
      allow update: if isAuthenticated() && (
        (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid) ||
        (!isPersonal(resource.data) && isMember(resource.data) && canManageWorkspace(resource.data) &&
         request.resource.data.ownerUid == resource.data.ownerUid &&
         request.resource.data.memberRoles == resource.data.memberRoles &&
         request.resource.data.members == resource.data.members) ||
        (!isPersonal(resource.data) &&
         request.resource.data.ownerUid == resource.data.ownerUid &&
         request.resource.data.type == resource.data.type &&
         request.resource.data.members.hasAll(resource.data.members) &&
         request.resource.data.members.size() == resource.data.members.size() + 1 &&
         (request.auth.uid in request.resource.data.members) &&
         !(request.auth.uid in resource.data.members) &&
         ((resource.data.get('memberRoles', null) == null &&
           request.resource.data.memberRoles.keys().hasOnly([request.auth.uid]) &&
           request.resource.data.memberRoles.keys().size() == 1) ||
          (resource.data.get('memberRoles', null) != null &&
           request.resource.data.memberRoles.diff(resource.data.memberRoles).changedKeys().size() == 0 &&
           request.resource.data.memberRoles.diff(resource.data.memberRoles).removedKeys().size() == 0 &&
           request.resource.data.memberRoles.diff(resource.data.memberRoles).addedKeys().hasOnly([request.auth.uid]) &&
           request.resource.data.memberRoles.diff(resource.data.memberRoles).addedKeys().size() == 1)) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberRoles', 'lastInviteTokenHash', 'updatedAt']) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
          request.resource.data.updatedAt == request.time) &&
         isValidInviteJoin(resource.data, request.resource.data))
      );

      // Only owner can delete the workspace
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // Diary entries subcollection
      match /entries/{entryId} {
        allow read: if isMember(getWorkspace());
        allow create: if canCreateEntries(getWorkspace()) &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update: if canEditEntry(getWorkspace(), resource.data);
        allow delete: if canDeleteEntry(getWorkspace(), resource.data);
      }

      // Categories subcollection: Only Owner and Admin can manage categories (Editors cannot)
      match /categories/{categoryId} {
        allow read: if isMember(getWorkspace());
        allow write: if canManageWorkspace(getWorkspace());
      }

      // Members subcollection:
      // - Add member on accept: Owner or Admin, or self-join via invite
      // - Change role: Owner ONLY
      // - Remove member: Owner ONLY (or member leaving themselves)
      match /members/{memberUid} {
        allow read: if isMember(getWorkspace());
        allow create: if (
          (canManageWorkspace(getWorkspace()) && request.resource.data.role != 'owner') ||
          (!isPersonal(getWorkspace()) &&
           isAuthenticated() &&
           request.auth.uid == memberUid &&
           request.resource.data.inviteTokenHash is string &&
           request.resource.data.role in ['editor', 'viewer'] &&
           getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteTokenHash)).data.status == 'accepted' &&
           getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteTokenHash)).data.acceptedByUid == request.auth.uid &&
           getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteTokenHash)).data.role == request.resource.data.role &&
           getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteTokenHash)).data.workspaceId == workspaceId
          )
        );
        allow update: if (isOwner(getWorkspace()) && request.resource.data.role != 'owner') ||
          (isAuthenticated() && request.auth.uid == memberUid &&
           isMember(getWorkspace()) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'lastSeen', 'lastSessionId', 'activeSessions']) &&
           request.resource.data.role == resource.data.role &&
           request.resource.data.status == resource.data.status);
        allow delete: if (isOwner(getWorkspace()) && resource.data.role != 'owner') ||
          (isAuthenticated() && request.auth.uid == memberUid && resource.data.role != 'owner');
      }

      // Invitations subcollection (Family & Business only: Owner & Admin only)
      match /invitations/{invitationId} {
        allow read, write: if canManageWorkspace(getWorkspace()) && !isPersonal(getWorkspace());
      }

      // Join Requests subcollection (Family & Business only)
      match /joinRequests/{requestId} {
        allow create: if isAuthenticated() &&
          request.resource.data.uid == request.auth.uid &&
          !isPersonal(getWorkspace());
        allow read: if canManageWorkspace(getWorkspace()) ||
          (isAuthenticated() && resource.data.uid == request.auth.uid);
        allow update: if canManageWorkspace(getWorkspace()) ||
          (isAuthenticated() && resource.data.uid == request.auth.uid);
        allow delete: if canManageWorkspace(getWorkspace());
      }

      // Tamper-resistant Activity Audit Logs
      match /activityLogs/{activityId} {
        allow read: if isMember(getWorkspace());
        allow create: if isMember(getWorkspace()) &&
          request.resource.data.userUid == request.auth.uid &&
          request.resource.data.workspaceId == workspaceId &&
          isValidActivityAction(getWorkspace(), request.resource.data);
        allow update, delete: if false;
      }
    }

    // Default deny for all other collection routes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
