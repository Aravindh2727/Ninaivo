# Staging Firebase Configuration (SEPARATE FROM PRODUCTION)
# Use a dedicated staging project (e.g. diary-tracker-staging) with test accounts
VITE_FIREBASE_API_KEY=your_staging_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=diary-tracker-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=diary-tracker-staging
VITE_FIREBASE_STORAGE_BUCKET=diary-tracker-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_staging_messaging_sender_id
VITE_FIREBASE_APP_ID=your_staging_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_staging_measurement_id

# Cloudinary Staging Configuration (Use separate staging upload preset)
VITE_CLOUDINARY_CLOUD_NAME=your_staging_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_staging_upload_preset

